{% comment %}
  Tryora app embed. Turn on in Theme settings > App embeds.
  Product previews remain product-scoped; the merchant can enable the room assistant on supported page types.
{% endcomment %}
<div
  id="tryora-root"
  hidden
  data-page-type="{{ request.page_type | escape }}"
  {% if product %}
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle | escape }}"
    data-option-names="{{ product.options | json | escape }}"
    data-variant-options="{{ product.selected_or_first_available_variant.options | json | escape }}"
  {% endif %}
  {% if collection %}
    data-collection-id="{{ collection.id }}"
    data-collection-handle="{{ collection.handle | escape }}"
  {% endif %}
></div>
{{ 'tryora.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tryora.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Tryora",
  "target": "body",
  "settings": []
}
{% endschema %}
