{% comment %}
  Tryora app embed. Turn on in Theme settings > App embeds. Loads only on product pages.
  Which products are live, the style and how the button looks are all set in the Tryora app.
{% endcomment %}
{% if product %}
  <div
    id="tryora-root"
    hidden
    data-product-id="{{ product.id }}"
    data-option-names="{{ product.options | json | escape }}"
    data-variant-options="{{ product.selected_or_first_available_variant.options | json | escape }}"
  ></div>
  {{ 'tryora.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'tryora.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Tryora",
  "target": "body",
  "settings": []
}
{% endschema %}
