# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
IMAGE_PROVIDER=mock
OPENAI_IMAGE_MODEL=gpt-image-2
# Explicit acknowledgement after reviewing OpenAI data controls; does not mean zero retention.
OPENAI_IMAGE_PRIVACY_ACKNOWLEDGED=false
# Vision-capable Responses API model used for transient room analysis and catalogue-grounded chat.
OPENAI_ASSISTANT_MODEL=gpt-4.1-mini
# Separate acknowledgement for sending room photos and bounded Shopify catalogue/policy context to OpenAI.
OPENAI_ASSISTANT_PRIVACY_ACKNOWLEDGED=false
GOOGLE_API_KEY=
# Verified Shopify development stores only. Finite test credits per UTC calendar month.
# 0 disables new test credits; existing grants/history are preserved. Maximum 10000.
TRYORA_DEV_TEST_CREDITS_PER_MONTH=0
DATABASE_URL=postgresql://user:password@localhost:5432/tryora

# Customization providers: enable only after the existing reviewed table rollout.
TRYORA_CUSTOMIZATION_PROVIDERS_ENABLED=false
# Exact authenticated myshopify.com shop hostnames, comma separated. Empty denies all.
# Set this before turning the master flag on. No wildcards, URLs or custom domains.
# Unset preserves legacy deployment-wide opt-in; do not unset to revoke one shop.
TRYORA_CUSTOMIZATION_PROVIDERS_SHOPS=
