# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
IMAGE_PROVIDER=mock
OPENAI_IMAGE_MODEL=gpt-image-2
# Explicit acknowledgement after reviewing OpenAI data controls; does not mean zero retention.
OPENAI_IMAGE_PRIVACY_ACKNOWLEDGED=false
# Vision-capable Responses API model used for transient room analysis and catalogue-grounded chat.
OPENAI_ASSISTANT_MODEL=gpt-4.1-mini
# Separate acknowledgement for sending room photos and bounded Shopify catalogue/policy context to OpenAI.
OPENAI_ASSISTANT_PRIVACY_ACKNOWLEDGED=false
GOOGLE_API_KEY=
DATABASE_URL=postgresql://user:password@localhost:5432/tryora
